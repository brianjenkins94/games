{
  "name": "war2",
  "description": "A Warcraft II clone on a deterministic bitecs sim \u2014 being moved here from the old monorepo, onto netsim's skeleton (see MIGRATION.md).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --run test:node && node --run test:oracle",
    "test:node": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-skip-pattern=\"random-plains\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=80 \"test/sim.test.ts\" \"test/validate.test.ts\" \"test/snapshot.test.ts\"",
    "test:oracle": "tsx --test \"test/oracle.test.ts\" \"test/snapshot.test.ts\"",
    "record": "tsx test/oracle/record.ts"
  },
  "dependencies": {
    "bitecs": "^0.4.0"
  },
  "devDependencies": {
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
