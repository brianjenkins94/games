{
  "name": "war2",
  "description": "A Warcraft II clone on a deterministic bitecs sim \u2014 being moved here from the old monorepo, onto netsim's skeleton (see MIGRATION.md).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5181",
    "build": "node scripts/build.ts",
    "test": "node --run test:node && node --run test:oracle && node --run test:browser",
    "test:node": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-skip-pattern=\"random-plains\" --test-coverage-lines=92 --test-coverage-branches=87 --test-coverage-functions=86 \"test/sim.test.ts\" \"test/collide.test.ts\" \"test/validate.test.ts\" \"test/snapshot.test.ts\" \"test/ui.test.ts\" \"test/pathology.test.ts\" \"test/incidents.test.ts\" \"test/recorder.test.ts\" \"test/maps.test.ts\" \"test/net/*.test.ts\"",
    "test:oracle": "tsx --test \"test/oracle.test.ts\" \"test/snapshot.test.ts\" \"test/pathology.test.ts\"",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.test.ts\"",
    "record": "tsx test/oracle/record.ts",
    "compare:zero-knowledge": "node test/browser/zero-knowledge/compare.ts"
  },
  "dependencies": {
    "@brianjenkins94/hub": "https://brianjenkins94.github.io/editor/packages/hub@latest.tgz",
    "@brianjenkins94/observability": "https://brianjenkins94.github.io/editor/packages/observability@latest.tgz",
    "bitecs": "^0.4.0",
    "peerjs": "^1.5.5",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "peer": "^1.0.2",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
