{
  "name": "games",
  "author": "Brian Jenkins",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "util-build",
    "lint": "util-lint",
    "test": "pnpm --recursive --if-present test",
    "postinstall": "util-postinstall",
    "purge": "find . \\( -name \"node_modules\" -or -name \"pnpm-*.yaml\" -or -name \"dist\" -or -name \"package-lock.json\" \\) -prune -exec rm -rf \"{}\" +;"
  },
  "devDependencies": {
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@tsconfig/node-lts": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
